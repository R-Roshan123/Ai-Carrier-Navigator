PORT=5000
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api
JWT_SECRET=replace_with_a_secure_secret
DATABASE_URL=postgresql://postgres:replace_with_password@db.your-project.supabase.co:5432/postgres
OPENAI_API_KEY=replace_with_openai_key
# AI career assistant (Groq). GROQ_MODEL is optional; defaults to openai/gpt-oss-120b.
GROQ_API_KEY=replace_with_groq_key
GROQ_MODEL=
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
NODE_ENV=development
# Career Roadmap module: this existing user is promoted to admin by `npm run seed:career`
ADMIN_EMAIL=admin@example.com
# Code required to create an admin account at /admin/signup. Leave empty to disable admin signup.
ADMIN_SIGNUP_CODE=
# Optional: where certificate uploads are stored (default: server/uploads)
UPLOAD_DIR=
